<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".WeckerOrtsweckerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Ergänzung: Vollbild-Alarm für den Orts-Zeit-Wecker. Ton/Vibration
             laufen unabhängig vom Benachrichtigungskanal in einem eigenen
             Foreground-Service (siehe AlarmRingService.java), bis der Nutzer
             im Klingel-Bildschirm wischt. -->
        <service
            android:name=".AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Zuverlässiger Hintergrundbetrieb (Ergänzung): dauerhafter
             Keep-alive-Foreground-Service mit dezenter Notification
             ("Orts-Zeit-Wecker aktiv"), analog zu Fitness-Tracker-/
             Navigations-Apps - siehe GeofenceForegroundService.java. -->
        <service
            android:name=".GeofenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Bugfix: Standard-Wecker klingelte bei komplett beendetem
             App-Prozess nur einmalig (Kanal-Standardton der
             @capacitor/local-notifications-Benachrichtigung) statt über
             AlarmRingService in Schleife - siehe StandardAlarmReceiver.java.
             Nur von unserem eigenen, nativ gestellten AlarmManager-Alarm
             angesprochen (siehe LocationAlarmBridgePlugin.
             scheduleStandardAlarm()), daher exported="false". -->
        <receiver
            android:name=".StandardAlarmReceiver"
            android:exported="false" />

        <!-- Phase 6, @capacitor-community/admob. admob_app_id (strings.xml) ist
             aktuell Googles offizielle TEST-App-ID - vor Store-Release durch die
             echte AdMob-App-ID ersetzen (siehe README). -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="@string/admob_app_id" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Standort im Vordergrund (Orts-Zeit-Wecker, Phase 3). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Hintergrund-Geofencing (Phase 4, @capgo/background-geolocation). Wird von der
         App erst nach Vordergrund-Zustimmung und mit Erklärung angefragt (siehe
         js/backgroundGeofence.js). FOREGROUND_SERVICE/-_LOCATION, POST_NOTIFICATIONS,
         WAKE_LOCK und RECEIVE_BOOT_COMPLETED bringt das Plugin über sein eigenes
         AndroidManifest.xml automatisch mit. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Vollbild-Alarm-Ergänzung für den Orts-Zeit-Wecker-Klingel-Bildschirm.
         USE_FULL_SCREEN_INTENT ist eine "normal" eingestufte Berechtigung und
         wird bei der Installation automatisch erteilt - AUSSER auf Android 14
         (API 34)+, wo der Nutzer sie zusätzlich manuell in den
         Systemeinstellungen freigeben muss (siehe LocationAlarmBridgePlugin.
         canUseFullScreenIntent()/openFullScreenIntentSettings() und den
         zugehörigen Hinweis-Dialog in locationAlarms.js). POST_NOTIFICATIONS
         und VIBRATE bringt @capacitor/local-notifications bzw.
         @capacitor/haptics bereits über ihr eigenes Manifest mit. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Zuverlässiger Hintergrundbetrieb für das Geofencing (Ergänzung):
         FOREGROUND_SERVICE_LOCATION ist ab Android 14 (API 34) zwingend für
         einen Foreground-Service mit foregroundServiceType="location"
         zusätzlich zu ACCESS_BACKGROUND_LOCATION nötig (siehe
         GeofenceForegroundService.java). REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         erlaubt den direkten System-Dialog zur Freigabe der
         Akku-Optimierung-Ausnahme (siehe LocationAlarmBridgePlugin.
         requestIgnoreBatteryOptimizations() und den zugehörigen
         Hinweis-Dialog in locationAlarms.js) - ist eine "special use"-
         Berechtigung, die Google Play beim Veröffentlichen im Play-
         Console-Formular begründet werden muss (siehe README, Abschnitt
         Release-Checkliste). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Bugfix: Wecker feuerte auf Geräten mit Android 12+ nicht zuverlässig
         (insb. nach längerer Inaktivität/Doze, z. B. über Nacht). Ursache:
         @capacitor/local-notifications prüft intern
         AlarmManager.canScheduleExactAlarms() - ohne diese Berechtigung
         weicht es auf einen NICHT exakten, NICHT Doze-umgehenden Alarm aus
         (AlarmManager.set() statt setExactAndAllowWhileIdle()), der um
         Stunden verzögert oder erst beim nächsten Wartungsfenster feuern
         kann. Ab targetSdk 34 wird SCHEDULE_EXACT_ALARM nicht mehr
         automatisch gewährt (Nutzer müsste es manuell in den Einstellungen
         freigeben) - USE_EXACT_ALARM dagegen wird für Apps, die tatsächlich
         Wecker-/Erinnerungsfunktionalität anbieten (wie diese hier), ohne
         Nutzerinteraktion automatisch gewährt und ist laut Google-Play-
         Richtlinien genau für diesen Anwendungsfall vorgesehen. Siehe auch
         alarms.js/timers.js: allowWhileIdle:true in den Schedule-Objekten,
         damit selbst der (durch diese Berechtigung nun eigentlich nicht mehr
         nötige) Fallback-Pfad des Plugins Doze umgehen würde. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
