# Vorlage fuer android/keystore.properties (git-ignoriert, siehe .gitignore).
# Kopieren zu "keystore.properties" und mit den echten Werten fuellen, NICHT
# committen. Anleitung zum Erzeugen des Keystores: README, Abschnitt
# "Release-Signing".

storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=weckerundort
keyPassword=CHANGE_ME
